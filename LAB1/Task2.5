import re

def clean_key(key: str) -> str:
    return re.sub(r"[^A-Za-z]", "", key).upper()


def clean_text(text: str) -> str:
    return re.sub(r"[^A-Za-z]", "", text).upper()

# Ham ma hoa chinh
def vigenere_encrypt(plaintext: str, key: str) -> str:
    pt  = clean_text(plaintext)
    key = clean_key(key)
    if not key:
        raise ValueError("Key must contain at least one letter.")

    cipher = []
    for i, ch in enumerate(pt):
        p = ord(ch)      - ord('A')
        k = ord(key[i % len(key)]) - ord('A')
        cipher.append(chr((p + k) % 26 + ord('A')))

    raw = "".join(cipher)
    
    return " ".join(raw[i:i+5] for i in range(0, len(raw), 5))

# Ham giai ma chinh
def vigenere_decrypt(ciphertext: str, key: str) -> str:
    ct  = clean_text(ciphertext)
    key = clean_key(key)
    if not key:
        raise ValueError("Key must contain at least one letter.")

    plain = []
    for i, ch in enumerate(ct):
        c = ord(ch)      - ord('A')
        k = ord(key[i % len(key)]) - ord('A')
        plain.append(chr((c - k + 26) % 26 + ord('A')))

    return "".join(plain)


ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

# ham in ra bang Vigenere Square (Tabula Recta)
def print_tabula_recta() -> None:
    header = "     " + "  ".join(ALPHA)
    sep    = "    +" + "---" * 26 + "-"
    print("\n  [*] VIGENÈRE SQUARE (Tabula Recta)")
    print("  " + header)
    print("  " + sep)
    for i, row_key in enumerate(ALPHA):
        row = [(chr((ord(col) - ord('A') + i) % 26 + ord('A'))) for col in ALPHA]
        print(f"   {row_key} | " + "  ".join(row))
    print()

# ham in ra bang Vigenere Square (Tabula Recta)
def print_step_table(text: str, key: str, mode: str) -> None:
    clean = clean_text(text)
    key_c = clean_key(key)
    n     = len(clean)

    print(f"\n  {'Index':<7} {'Input':<8} {'Key':<7} "
          f"{'In#':<6} {'Key#':<7} {'Out#':<7} {'Output'}")
    print("  " + "-" * 55)

    for i in range(min(n, 40)):       
        ch  = clean[i]
        kch = key_c[i % len(key_c)]
        p   = ord(ch)  - ord('A')
        k   = ord(kch) - ord('A')
        if mode == "enc":
            out_num = (p + k) % 26
        else:
            out_num = (p - k + 26) % 26
        out = chr(out_num + ord('A'))
        print(f"  {i:<7} {ch:<8} {kch:<7} {p:<6} {k:<7} {out_num:<7} {out}")

    if n > 40:
        print(f"  ... ({n - 40} more characters not shown)")
    print()


def print_separator(title: str = "") -> None:
    if title:
        side = (50 - len(title) - 2) // 2
        print("\n" + "=" * side + f" {title} " + "=" * side)
    else:
        print("\n" + "=" * 52)


